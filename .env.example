# Database
DATABASE_URL=postgresql+psycopg2://sdlc:sdlc_password@localhost:5432/agentic_sdlc

# OpenAI
OPENAI_API_KEY=your-key-here

# Logging
LOG_LEVEL=INFO

# Where generated code is committed (one git branch per ticket)
WORKSPACE_DIR=workspace

# Test execution: "docker" (sandboxed, default) or "local" (runs generated code on THIS machine,
# no isolation; also requires ALLOW_UNSAFE_LOCAL_RUNNER=1)
TEST_RUNNER=docker
TEST_TIMEOUT_SECONDS=120
# ALLOW_UNSAFE_LOCAL_RUNNER=1

# LLM provider: deepseek (default when DEEPSEEK_API_KEY is set) or openai
# DEEPSEEK_API_KEY=sk-...
# LLM_PROVIDER=deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model per role. The account currently offers deepseek-flash (cheap, fast) and deepseek-v4-pro.
# MODEL_PLANNING=deepseek-flash
# MODEL_CRITIQUE=deepseek-flash
# MODEL_IMPLEMENTATION=deepseek-flash
# A run stops cleanly once it has used this many tokens (a multi-feature ask needs ~1-3M)
# RUN_TOKEN_CAP=1000000
